
<form id="criarMovimentacao">

    <p>
        Valor: <input type="number" placeholder="R$: 0,00" id="valor">
    </p>
    <p>
        Descrição: <br><textarea  id="descricao" rows="5" placeholder="Digite a descrição"></textarea>
    </p>
    <p>tipo: 
        <select  id="tipo">
            <option value="entrada">Entrada</option>
            <option value="saida">Saida</option>
        </select>
        <button type="submit" >Criar movimentação</button>
       
    </p>
</form>