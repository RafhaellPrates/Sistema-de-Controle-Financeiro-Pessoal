<form id="cadastrar" method="post">
    <p>Nome:  
        <input type="text" id="nome" name="nome" placeholder="Dígite o seu nome" required>
    </p>    
    <p>Email: 
        <input type="email" id="email" name="email" placeholder="Dígite seu email"required>
    </p>
    <p>Senha: 
        <input type="password" id="senha" name="senha" placeholder="Dígite sua senha"required>
    </p>
    <button type="submit">Cadrastrar</button> <button type="button" id="login">Login</button>
</form>