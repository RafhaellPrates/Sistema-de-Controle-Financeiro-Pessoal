<h1>Histórico</h1>
<input type="button" id="voltar" value="Voltar">

{{#each transacoes}}

    <p>{{valor}}</p>
    <p>{{tipo}}</p>
    <p>{{descricao}}</p>
    <button class="deletar" data-id="{{id}}">Deletar</button>
    <button class="atualizar" data-id="{{id}}">Atualizar</button>
    <hr>

{{/each}}